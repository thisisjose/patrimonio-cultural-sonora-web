/* ==================== HERO SECTION ==================== */
.page-hero {
  padding: 3.5rem 0;
  text-align: center;
  background: linear-gradient(135deg, rgba(61, 125, 104, 0.05) 0%, rgba(212, 165, 116, 0.05) 100%);
  border-radius: var(--radius-xl);
  margin-bottom: 2.5rem;
}

.page-hero .hero-title {
  font-size: 3.2rem;
  color: var(--primary-dark);
  margin-bottom: 1rem;
}

.hero-sub {
  max-width: 800px;
  color: var(--text-secondary);
  font-size: 1.1rem;
  margin: 0 auto 0;
  line-height: 1.7;
}

/* ==================== FEATURES GRID ==================== */
.features-grid {
  max-width: 1200px;
  margin: 0 auto 3rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.feature-card {
  background: var(--card);
  padding: 2rem;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: flex-start;
  transition: all var(--transition-base);
  border: 1px solid rgba(212, 165, 116, 0.1);
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--accent-sand), var(--accent-terracota));
}

.feature-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-sand);
}

.feature-icon {
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.15), rgba(232, 103, 75, 0.15));
  border-radius: var(--radius-base);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon img {
  width: 32px;
  height: 32px;
  object-fit: contain;
  filter: saturate(1.1);
}

.feature-title {
  font-weight: 700;
  color: var(--primary-dark);
  font-size: 1.1rem;
}

.feature-desc {
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.6;
}

/* ==================== FILTERS SECTION ==================== */
.municipio-selector-wrapper {
  max-width: 1200px;
  margin: 0 auto 2.5rem;
  padding: 2rem;
  background: linear-gradient(135deg, var(--card) 0%, rgba(255, 255, 255, 0.5) 100%);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}

.municipio-selector-content {
  display: flex;
  align-items: flex-end;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
}

.filter-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.filter-label {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--primary-dark);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Search input */
.search-box-container {
  position: relative;
  flex-shrink: 0;
  flex: 1;
  min-width: 280px;
}

.search-box-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.patrimonio-search-input {
  width: 100%;
  padding: 0.9rem 2.8rem 0.9rem 1.3rem;
  border-radius: var(--radius-base);
  border: 2px solid var(--border);
  background: var(--card);
  color: var(--text-primary);
  font-weight: 500;
  font-family: var(--font-sans);
  font-size: 0.95rem;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}

.patrimonio-search-input:hover {
  border-color: var(--accent-sand);
  box-shadow: 0 4px 16px rgba(212, 165, 116, 0.15);
}

.patrimonio-search-input:focus {
  outline: none;
  border-color: var(--accent-terracota);
  box-shadow: 0 4px 16px rgba(232, 103, 75, 0.2);
}

.patrimonio-search-input::placeholder {
  color: var(--text-muted);
}

.search-clear-btn {
  position: absolute;
  right: 0.9rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 1.2rem;
  cursor: pointer;
  padding: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: color var(--transition-fast);
}

.search-clear-btn:hover {
  color: var(--accent-terracota);
}

/* Select inputs */
.municipio-select-main {
  padding: 0.9rem 1.3rem;
  border-radius: var(--radius-base);
  border: 2px solid var(--border);
  background: var(--card);
  color: var(--text-primary);
  font-weight: 500;
  font-family: var(--font-sans);
  font-size: 0.95rem;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233D7D68' stroke-width='2'%3e%3cpath d='M6 9l6 6 6-6'%3e%3c/path%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 0.9rem center;
  background-size: 1.1em;
  padding-right: 2.6rem;
}

.municipio-select-main:hover {
  border-color: var(--accent-sand);
  box-shadow: 0 4px 16px rgba(212, 165, 116, 0.15);
}

.municipio-select-main:focus {
  outline: none;
  border-color: var(--accent-terracota);
  box-shadow: 0 4px 16px rgba(232, 103, 75, 0.2);
}

.municipio-select-main option {
  padding: 0.5rem;
  color: var(--text-primary);
  background: var(--card);
}

/* ==================== SEARCH RESULTS ==================== */
.search-results-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--card);
  border: 2px solid var(--accent-sand);
  border-top: none;
  border-radius: 0 0 var(--radius-base) var(--radius-base);
  box-shadow: var(--shadow-lg);
  max-height: 420px;
  overflow-y: auto;
  z-index: 1001;
}

.search-result-item {
  padding: 0.85rem 1rem;
  cursor: pointer;
  display: flex;
  gap: 0.85rem;
  align-items: center;
  transition: all var(--transition-fast);
  border-bottom: 1px solid var(--border);
}

.search-result-item:hover {
  background: rgba(212, 165, 116, 0.08);
}

.search-result-item:last-child {
  border-bottom: none;
}

.result-image {
  width: 54px;
  height: 54px;
  border-radius: var(--radius-base);
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--border), rgba(212, 165, 116, 0.2));
}

.result-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.result-content {
  flex: 1;
  min-width: 0;
}

.result-name {
  font-weight: 600;
  color: var(--primary-dark);
  font-size: 0.95rem;
  margin-bottom: 0.4rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-category {
  display: flex;
  gap: 0.5rem;
}

.result-badge {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 4px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: capitalize;
  color: #fff;
}

.result-badge.material { background: var(--accent-terracota); }
.result-badge.inmaterial { background: var(--secondary-blue); }
.result-badge.biocultural { background: var(--primary-light); }

.search-no-results {
  padding: 1.5rem;
  text-align: center;
  color: var(--text-muted);
  font-size: 0.95rem;
  background: rgba(212, 165, 116, 0.05);
}

/* ==================== PATRIMONIOS GRID ==================== */
.patrimonios-grid {
  max-width: 1200px;
  margin: 2.5rem auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.patrimonio-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: var(--shadow);
  transition: all var(--transition-base);
  border: 1px solid var(--border);
  cursor: pointer;
}

.patrimonio-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-sand);
}

.patrimonio-thumb {
  width: 100%;
  height: 180px;
  border-radius: var(--radius-base);
  background: linear-gradient(135deg, var(--border), rgba(212, 165, 116, 0.2));
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-weight: 700;
  overflow: hidden;
}

.patrimonio-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.patrimonio-meta {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.patrimonio-name {
  font-weight: 700;
  color: var(--primary-dark);
  font-size: 1rem;
  line-height: 1.4;
}

.patrimonio-desc {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.5;
}

/* ==================== POPULAR SECTION ==================== */
.popular-section {
  max-width: 1200px;
  margin: 3rem auto;
}

.section-title {
  font-family: var(--font-heading);
  font-size: 2.4rem;
  color: var(--primary-dark);
  margin-bottom: 0.5rem;
  text-align: center;
  letter-spacing: -0.5px;
}

.section-subtitle {
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent-sand);
  margin-bottom: 1.5rem;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.popular-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
}

.popular-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: all var(--transition-base);
  border: 1px solid var(--border);
  cursor: pointer;
}

.popular-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-sand);
}

.popular-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: linear-gradient(135deg, var(--border), rgba(212, 165, 116, 0.2));
}

.popular-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform var(--transition-base);
}

.popular-card:hover .popular-thumb img {
  transform: scale(1.05);
}

.popular-content {
  padding: 1.2rem 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 80px;
}

.popular-name {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--primary-dark);
  line-height: 1.35;
}

.popular-badge {
  position: absolute;
  left: 1rem;
  bottom: 1rem;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 0.7rem;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: var(--shadow-lg);
}

.popular-badge.material { background: var(--accent-terracota); }
.popular-badge.inmaterial { background: var(--secondary-blue); }
.popular-badge.biocultural { background: var(--primary-light); }

/* ==================== RESPONSIVE ==================== */
@media (max-width: 980px) {
  .features-grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .patrimonios-grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .municipio-selector-content { gap: 1rem; }
}

@media (max-width: 768px) {
  .page-hero { padding: 2.5rem 0; margin-bottom: 2rem; }
  .page-hero .hero-title { font-size: 2.2rem; }
  .hero-sub { font-size: 1rem; }
  .features-grid { grid-template-columns: 1fr; gap: 1rem; }
  .feature-card { padding: 1.5rem; }
  .municipio-selector-wrapper { padding: 1.5rem; margin: 0 auto 2rem; }
  .municipio-selector-content { flex-direction: column; gap: 1rem; }
  .search-box-container, .municipio-selector-content > div {
    width: 100%;
  }
  .patrimonio-search-input, .municipio-select-main {
    width: 100%;
  }
  .search-results-dropdown { max-height: 320px; }
  .patrimonios-grid { grid-template-columns: 1fr; gap: 1rem; }
  .patrimonio-thumb { height: 220px; }
  .popular-row { grid-template-columns: repeat(2, 1fr); }
  .section-title { font-size: 2rem; }
}

@media (max-width: 480px) {
  .page-hero { padding: 1.5rem 0; margin-bottom: 1.5rem; }
  .page-hero .hero-title { font-size: 1.8rem; }
  .hero-sub { font-size: 0.95rem; }
  .features-grid { margin: 0 auto 1.5rem; gap: 0.75rem; }
  .feature-card { padding: 1.25rem; }
  .municipio-selector-wrapper { padding: 1.25rem; margin: 0 auto 1.5rem; }
  .municipio-selector-content { gap: 0.75rem; }
  .patrimonios-grid { margin: 1.5rem auto; gap: 0.75rem; }
  .patrimonio-thumb { height: 160px; }
  .popular-row { grid-template-columns: 1fr; }
  .popular-card { max-width: 100%; }
  .popular-thumb { height: 240px; }
  .section-title { font-size: 1.6rem; margin-bottom: 0.4rem; }
  .section-subtitle { margin-bottom: 1.2rem; }
}
